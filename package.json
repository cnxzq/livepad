{
  "name": "livepad-workspace",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "description": "\u5b9e\u65f6\u534f\u4f5c\u4fbf\u7b7e + \u6587\u4ef6\u5171\u4eab \u2014 \u96f6\u4f9d\u8d56 SSE \u540c\u6b65",
  "scripts": {
    "start": "pnpm --filter livepad start",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "lint": "pnpm -r lint && node --check scripts/docker.js",
    "build": "pnpm -r build",
    "check": "pnpm run lint && pnpm test && pnpm run build",
    "pack": "pnpm -r pack --pack-destination .release/npm",
    "publish:npm": "pnpm run check && pnpm -r publish --access public --registry=https://registry.npmjs.org --publish-branch=main",
    "docker:build": "node scripts/docker.js build",
    "docker:push": "node scripts/docker.js push",
    "publish:docker": "node scripts/docker.js publish"
  },
  "keywords": [
    "realtime",
    "collaborative",
    "notepad",
    "sync",
    "sse",
    "zero-dependency"
  ],
  "author": "zhuqiang",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cnxzq/livepad"
  },
  "bugs": {
    "url": "https://github.com/cnxzq/livepad/issues"
  },
  "homepage": "https://github.com/cnxzq/livepad#readme"
}
